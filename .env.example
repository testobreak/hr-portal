# Copy this file to `.env` and edit values for your local box.
# `.env` is gitignored. NEVER commit real secrets.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_local_dev_change_me
POSTGRES_PORT=5432

# --- Security / JWT ---------------------------------------------------------
HRMS_JWT_SECRET_KEY=dev-secret-key-must-be-at-least-256-bits-long-32-bytes-to-be-secure
HRMS_JWT_EXPIRATION_MS=3600000

# --- MinIO (S3-compatible) --------------------------------------------------
MINIO_ROOT_USER=hrms_minio_admin
MINIO_ROOT_PASSWORD=hrms_minio_local_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCUMENTS=hrms-documents

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Backend ----------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
# Set true when MinIO is up (local profile enables storage by default in application-local.yml).
# HRMS_STORAGE_ENABLED=true

# S3 / MinIO overrides for Spring (optional; local profile wires MinIO from vars above)
# HRMS_S3_BUCKET=hrms-documents
# HRMS_S3_ENDPOINT=http://127.0.0.1:9000
# HRMS_S3_ACCESS_KEY=hrms_minio_admin
# HRMS_S3_SECRET_KEY=hrms_minio_local_change_me

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# --- App defaults -----------------------------------------------------------
APP_DEFAULT_CURRENCY=INR
APP_DEFAULT_TIMEZONE=Asia/Kolkata
